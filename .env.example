# Copy to .env and fill in. Never commit .env.
# Leave a value empty to disable that feature (a warning is logged). Every other setting has a
# sensible default in app/config.py; add it here only if you want to change it.

# ---------------- Required ----------------
API_KEY=                           # dashboard/API login. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"

# ---------------- App ----------------
APP_ENV=production                 # development | production
LOG_JSON=true                      # false = readable console logs (development)
RUN_SCHEDULER=true                 # in-process 3-hourly sync; set false when using the cron URL
RUN_BOT=true                       # Telegram command replies

# ---------------- Storage (JSON files, no database) ----------------
STORAGE_BACKEND=local              # local = storage/data/*.json | gist = private GitHub Gist (Render free)
GIST_ID=                           # gist only
GITHUB_TOKEN=                      # gist only: token with ONLY the "gist" scope

# ---------------- Sync URL (external cron, e.g. cron-job.org) ----------------
SYNC_TOKEN=                        # enables GET /cron/sync?token=...

# ---------------- AI ----------------
AI_PROVIDER=openai                 # openai | ollama | none (none = rule-based scores only)
AI_FALLBACK_PROVIDER=none          # openai | ollama | none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ---------------- Telegram ----------------
TELEGRAM_BOT_TOKEN=                # from @BotFather
TELEGRAM_ALLOWED_CHAT_IDS=         # your chat id (send /start to the bot to see it)

# ---------------- Optional job sources ----------------
# Adzuna (free key at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# LinkedIn / BDJobs alert emails (Gmail: use an App Password)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# Company career boards, JSON list, e.g. [{"kind":"greenhouse","identifier":"gitlab"}]
CAREER_SOURCES=[]

# ---------------- Advanced (defaults shown; uncomment to change) ----------------
# TIMEZONE=Asia/Dhaka
# DIGEST_HOUR=9
# COLLECT_INTERVAL_HOURS=3
# ALERT_THRESHOLD=80
# PREFILTER_MIN_SCORE=35
# SEARCH_KEYWORDS=laravel,php,python,fastapi,full stack,backend
# ADZUNA_COUNTRIES=gb,us,de,sg
# BDJOBSTODAY_CATEGORIES=3,5
# RATE_LIMIT=60/minute
# MAX_JOBS=3000
